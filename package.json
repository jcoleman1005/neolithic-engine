{
  "name": "neolithic-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "postinstall": "node scripts/patch-vitest.js",
    "test": "vitest run",
    "test:fast": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "check": "tsc -b --pretty",
    "verify": "bash scripts/verify.sh",
    "sim": "vite-node scripts/run.ts --",
    "bands": "vite-node scripts/bands.ts --",
    "stockpiles": "vite-node scripts/stockpiles.ts --",
    "sweep": "vite-node scripts/sweep.ts --",
    "farming": "vite-node scripts/farming.ts --",
    "movement": "vite-node scripts/movement.ts --",
    "culture": "vite-node scripts/culture.ts --",
    "chronicle": "vite-node scripts/chronicle.ts --",
    "fingerprint": "vite-node scripts/fingerprint.ts --",
    "map": "vite-node scripts/map-dump.ts --",
    "capture": "vite-node scripts/capture.ts --",
    "probe": "vite-node scripts/settle-probe.ts --",
    "watch-probe": "vite-node scripts/watch-probe.ts --",
    "compare": "vite-node scripts/compare.ts --",
    "perf": "vite-node scripts/perf.ts",
    "visual": "vite-node scripts/visual-check.ts --",
    "visual:update": "vite-node scripts/visual-check.ts -- --update true",
    "build:server": "vite build --ssr server/main.ts --outDir dist-server --emptyOutDir",
    "server": "npm run build && npm run build:server && node dist-server/main.js",
    "server:start": "node dist-server/main.js",
    "server:new": "npm run build && npm run build:server && node -e \"require('fs').rmSync('scratch/live',{recursive:true,force:true})\" && node dist-server/main.js --data scratch/live"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "playwright": "^1.65.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^3.1.3"
  }
}
